# Copy to .env and fill in real values. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=replace-with-bot-token

# --- Paxmod (https://www.paxmod.com/console) ---
PAXMOD_API_KEY=replace-with-paxmod-project-key
PAXMOD_BASE_URL=https://www.paxmod.com/api/v1
PAXMOD_DAILY_CAP=2000

# --- Jev / TypeSafe (https://console.typesafe.ai/keys) ---
TYPESAFE_API_KEY=replace-with-typesafe-key
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_DAILY_CAP=2000

# --- OCR.space (Copyfish engine; https://ocr.space/ocrapi/freekey) ---
OCR_API_KEY=replace-with-ocr-space-key
OCR_BASE_URL=https://api.ocr.space
OCR_ENGINE=2
OCR_DAILY_CAP=400
OCR_TIMEOUT_MS=4000
OCR_MAX_UPLOAD_BYTES=1000000

# --- Provider behavior ---
PROVIDER_TIMEOUT_MS=1500
BUDGET_RESERVED_SHARE=0.5

# --- Runtime ---
DATABASE_URL=sqlite://data/guard.db
CONFIG_PATH=config.toml
# Optional: guild whose admins may manage OTHER servers' configs
# (/guard config show|set|reset guild:<id> and /guard guilds, usable only there).
# MANAGER_GUILD_ID=123456789012345678
RUST_LOG=info,sudobot_chat_guard=debug
